  "feature_descriptions": {
    "URLLength": "Number of characters in the URL (n).",
    "DomainLength": "Number of characters in the host, including any port.",
    "IsDomainIP": "1 if the host contains a dotted IPv4 address or is an IP literal.",
    "CharContinuationRate": "(longest letter run + longest digit run + longest symbol run) / len(core).",
    "TLDLegitimateProb": "Per-TLD legitimacy prior from the PhiUSIIL table; 0.0 for TLDs not in the table.",
    "TLDLength": "Length of the last dot-separated label of the host.",
    "NoOfSubDomain": "Number of dots in the host minus one (never below zero).",
    "NoOfLettersInURL": "ASCII letters in body.",
    "LetterRatioInURL": "NoOfLettersInURL / n, rounded to 3 decimals.",
    "NoOfDegitsInURL": "Digits in body.",
    "DegitRatioInURL": "NoOfDegitsInURL / n, rounded to 3 decimals.",
    "NoOfEqualsInURL": "'=' characters in body.",
    "NoOfQMarkInURL": "'?' characters in body.",
    "NoOfAmpersandInURL": "'%' characters in body (the dataset column is misnamed; it does not count '&').",
    "NoOfOtherSpecialCharsInURL": "Non-alphanumeric characters in body other than '=', '?' and '%'.",
    "SpacialCharRatioInURL": "(other special chars + '=' + '?' + '%') / n, rounded to 3 decimals.",
    "IsHTTPS": "1 if 'https' occurs anywhere in the URL."
  },

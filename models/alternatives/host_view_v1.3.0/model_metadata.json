  "feature_descriptions": {
    "URLLength": "Number of characters in the URL (n).",
    "DomainLength": "Number of characters in the host, including any port.",
    "IsDomainIP": "1 if the host contains a dotted IPv4 address or is an IP literal.",
    "CharContinuationRate": "(longest letter run + longest digit run + longest symbol run) / len(core).",
    "TLDLegitimateProb": "Per-TLD legitimacy prior from the PhiUSIIL table; 0.0 for TLDs not in the table.",
    "TLDLength": "Length of the last dot-separated label of the host.",
    "NoOfSubDomain": "Number of dots in the host minus one (never below zero).",
    "NoOfLettersInURL": "ASCII letters in body.",
    "LetterRatioInURL": "NoOfLettersInURL / n, rounded to 3 decimals.",
    "NoOfDegitsInURL": "Digits in body.",
    "DegitRatioInURL": "NoOfDegitsInURL / n, rounded to 3 decimals.",
    "NoOfEqualsInURL": "'=' characters in body.",
    "NoOfQMarkInURL": "'?' characters in body.",
    "NoOfAmpersandInURL": "'%' characters in body (the dataset column is misnamed; it does not count '&').",
    "NoOfOtherSpecialCharsInURL": "Non-alphanumeric characters in body other than '=', '?' and '%'.",
    "SpacialCharRatioInURL": "(other special chars + '=' + '?' + '%') / n, rounded to 3 decimals.",
    "IsHTTPS": "1 if 'https' occurs anywhere in the URL."
  },
  "excluded_features": {
    "URLSimilarityIndex": "Label leakage: similarity to the dataset authors' legitimate-URL list, which is where the legitimate samples came from (value 100.0 for 100% of legitimate rows). Cannot be computed without that list.",
    "URLCharProb": "Requires the authors' external character-probability corpus; the best reconstruction reached 0.22% exact parity.",
    "HasObfuscation": "Original rule not recoverable (99.79% parity, below the 99.9% bar): the original tool ignores some %XX codes. Percent-encoding is still captured by NoOfAmpersandInURL.",
    "NoOfObfuscatedChar": "Same reason as HasObfuscation (99.79% parity).",
    "ObfuscationRatio": "Derived from NoOfObfuscatedChar; excluded with it."
  },
  "target_encoding": {
    "model_output": "predict_proba column for class 1 = P(phishing)",
    "dataset_label_phishing": 0,
    "dataset_label_legitimate": 1
  },
  "supports_probability": true,
  "thresholds": {
    "flag": 0.5015180937844725,
    "high_confidence_phishing": 0.5828151596908578,
    "flag_criterion": "Decision threshold = the lowest threshold whose VALIDATION false-positive rate is <= 5% (equivalently: maximum validation recall with at most 1 in 20 legitimate URLs flagged). Chosen before looking at test results; the test split is scored once at this threshold.",
    "definition": "P(phishing) < flag (0.501518) -> Safe; otherwise Phishing if P >= high_confidence_phishing (lowest threshold with validation precision >= 95%), else Suspicious. Binary metrics treat Suspicious and Phishing together as 'flagged'."
  },
  "selection_criteria": "Metric: validation recall at each model's own 5%-FPR threshold (all models compared at the same false-alarm rate, so the comparison does not depend on score calibration). The incumbent (hist_gradient_boosting__balanced, the v1.1.0 configuration) is kept unless a challenger's gain over it is significant: the 95% interval of a paired, class-stratified bootstrap of the validation set (1000 resamples, threshold re-derived in every resample) must lie entirely above zero. Among significant challengers the largest mean gain wins. Validation data only. (This rule replaced a fixed 0.002 tie margin after the first run showed that margin is smaller than the validation sampling error, ~0.005 recall.)",

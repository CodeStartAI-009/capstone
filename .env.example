# Copy to .env and adjust; load with:  set -a; source .env; set +a
# Never commit .env. This file contains placeholders only. See docs/api.md.

FLASK_DEBUG=false
API_HOST=127.0.0.1
API_PORT=5000

# Model artefacts produced by `python -m ml.train_model` (relative to the project root).
MODEL_PATH=models/phishing_model.pkl
MODEL_METADATA_PATH=models/model_metadata.json
TLD_TABLE_PATH=models/tld_legitimate_prob.json
DATABASE_PATH=instance/scan_history.db

MAX_CONTENT_LENGTH=16384
MAX_URL_LENGTH=2048
HISTORY_LIMIT=100
RATE_LIMIT_PER_MINUTE=60

# Browser origin(s) allowed to call the API cross-origin, comma-separated exact
# origins (scheme://host[:port]). "*" is refused. Leave empty when the UI is served
# by this Flask app (same origin). Example for a separately hosted frontend:
#   CLIENT_ORIGIN=https://phishing-ui.example.org
CLIENT_ORIGIN=
# Older name for the same setting; both are merged.
CORS_ORIGINS=

# Score localhost / private-network / internal host names (default: rejected with 400).
ALLOW_PRIVATE_HOSTS=false

# Optional threat intelligence (disabled when empty). Sends scanned URLs to Google.
THREAT_INTEL_PROVIDER=
GOOGLE_SAFE_BROWSING_API_KEY=
